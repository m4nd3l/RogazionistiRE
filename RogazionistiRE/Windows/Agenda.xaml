                                   TextTrimming="WordEllipsis"
                                   FontSize="15"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock Grid.Row="1" Text="{x:Bind LessonTranslated}" 
                                   Margin="12, 0, 12, 5"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   FontSize="13"
                                   VerticalAlignment="Bottom"
                                   Foreground="DarkGray"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
        <DataTemplate x:Key="HomeworkItemTemplate" x:DataType="obsData:ObservableHomework">
