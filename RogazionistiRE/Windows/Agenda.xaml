                                   TextTrimming="WordEllipsis"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    
                        <TextBlock Grid.Column="3" Text="{x:Bind DateFormatted}" 
