<Page
    x:Class="RogazionistiRE.Windows.Agenda"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RogazionistiRE.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:RogazionistiRE.JsonBlueprints"
    xmlns:obsData="using:RogazionistiRE.Data"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="CommandBarBackground"             Color="Transparent" />
        <SolidColorBrush x:Key="CommandBarBackgroundOpen"         Color="Transparent" />
        <SolidColorBrush x:Key="CommandBarBorderBrushOpen"        Color="Transparent" />
        <SolidColorBrush x:Key="CommandBarBackgroundPointerOver"  Color="Transparent" />
        <SolidColorBrush x:Key="CommandBarBackgroundPressed"      Color="Transparent" />
        <Thickness       x:Key="CommandBarBorderThicknessOpen">0</Thickness>
        
        <SolidColorBrush x:Key="LessonAccent" Color="#0078D4"/> 
        <SolidColorBrush x:Key="HomeworkAccent" Color="#D83B01"/> <SolidColorBrush x:Key="GradeAccent" Color="#107C10"/> 
        <SolidColorBrush x:Key="NoteAccent" Color="#8764B8"/> 
        
        <DataTemplate x:Key="LessonItemTemplate" x:DataType="data:LessonJson">
            <ItemContainer CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource LessonAccent}" CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BE;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource LessonAccent}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind DateFormatted}" Foreground="DarkGray" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" FontSize="14"/>
                            <TextBlock Text="{x:Bind LessonTranslated}" Foreground="DarkGray" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
        <DataTemplate x:Key="HomeworkItemTemplate" x:DataType="obsData:ObservableHomework">
            <ItemContainer CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource HomeworkAccent}" CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xED3C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource HomeworkAccent}" Margin="0,0,12,0"/>
                            <TextBlock Text="{x:Bind Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="{x:Bind DoneTranslated}" OffContent="{x:Bind NotDoneTranslated}" IsOn="{x:Bind Done, Mode=TwoWay}" Toggled="DoneCheckbox_Toggled" FontSize="12"/>
                    </Grid>
                    <Border Grid.Row="1" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="14"/>
                            <TextBlock Text="{x:Bind HomeworkTranslated}" Foreground="DarkGray" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
        <DataTemplate x:Key="GradesItemTemplate" x:DataType="data:GradeJson">
            <ItemContainer CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource GradeAccent}" CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{x:Bind SymbolColor}"/>
                            <TextBlock Text="{x:Bind Symbol}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Border Grid.Column="2" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{x:Bind Subtitle}" Foreground="White" FontSize="12"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind GradeTranslated}" Foreground="DarkGray" FontSize="12"/>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>

        <DataTemplate x:Key="NotesItemTemplate" x:DataType="data:NotesJson">
            <ItemContainer CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource NoteAccent}" CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NoteAccent}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Subtitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                    <Border Grid.Row="1" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Tag.Description}" Foreground="DarkGray" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
        </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

                <CommandBar Background="Transparent"
                    DefaultLabelPosition="Collapsed"
                    OverflowButtonVisibility="Collapsed"
                    IsOpen="True"
                    IsSticky="True"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center">

            <CommandBar.Resources>
                <Style TargetType="Button">
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                </Style>
            </CommandBar.Resources>

            <CommandBar.Content>
                <TextBlock Name="TitleDate" 
                           Margin="64,0,16,0" 
                           VerticalAlignment="Center" 
                           FontSize="22" 
                           FontWeight="Bold"/>
            </CommandBar.Content> 

            <AppBarElementContainer VerticalAlignment="Center">
                <Button Click="PreviousDate_Click" 
                        Content="&#xE72B;" 
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Padding="8"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        Name="Previous"/>
            </AppBarElementContainer>

            <AppBarElementContainer VerticalAlignment="Center">
                <CalendarDatePicker x:Name="DateSelector"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    DateChanged="DateChanged"/>
            </AppBarElementContainer> 

            <AppBarElementContainer VerticalAlignment="Center">
                <Button Click="NextDate_Click" 
                        Content="&#xE72A;" 
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Padding="8"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        Name="Next"/>
            </AppBarElementContainer>
            
            <AppBarElementContainer VerticalAlignment="Center">
                <Button Click="Today_Click" 
                        Margin="8, 0"
                        Content="&#xE8F5;" 
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Padding="8"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        Name="Today"/>
            </AppBarElementContainer>

            <AppBarSeparator VerticalAlignment="Center"/>

            <AppBarElementContainer VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <CheckBox Content="Lessons" Name="LessonsCheckbox" Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="True" Click="Checkbox_Click"/>
                    <CheckBox Content="Grades"  Name="GradesCheckbox"  Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="True" Click="Checkbox_Click"/>
                    <CheckBox Content="Notes"   Name="NotesCheckbox"   Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="True" Click="Checkbox_Click"/>
                </StackPanel>
            </AppBarElementContainer>
        </CommandBar>

        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="24">
                
                <StackPanel Spacing="8">
                    <ItemsView ItemsSource="{x:Bind LessonsCollection}" 
                               ItemTemplate="{StaticResource LessonItemTemplate}" 
                               SelectionMode="None">
                        <ItemsView.Layout><StackLayout Spacing="12"/></ItemsView.Layout>
                    </ItemsView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <ItemsView ItemsSource="{x:Bind HomeworkCollection}" 
                               ItemTemplate="{StaticResource HomeworkItemTemplate}" 
                               SelectionMode="None">
                        <ItemsView.Layout><StackLayout Spacing="12"/></ItemsView.Layout>
                    </ItemsView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <ItemsView ItemsSource="{x:Bind GradesCollection}" 
                               ItemTemplate="{StaticResource GradesItemTemplate}" 
                               SelectionMode="None">
                        <ItemsView.Layout><StackLayout Spacing="12"/></ItemsView.Layout>
                    </ItemsView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <ItemsView ItemsSource="{x:Bind NotesCollection}" 
                               ItemTemplate="{StaticResource NotesItemTemplate}" 
                               SelectionMode="None">
                        <ItemsView.Layout><StackLayout Spacing="12"/></ItemsView.Layout>
                    </ItemsView>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Name="NoHomework" FontSize="30"/>
    </Grid>
</Page>
