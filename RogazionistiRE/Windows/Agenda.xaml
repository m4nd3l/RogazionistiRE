                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        
                        <ToggleSwitch Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                      OffContent="{x:Bind NotDoneTranslated}" OnContent="{x:Bind DoneTranslated}" IsOn="{x:Bind Done, Mode=TwoWay}" 
                                      Toggled="DoneCheckbox_Toggled"/>
                    </Grid>


                    <Border Grid.Row="1"
                            Padding="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="0,0,4,4">
