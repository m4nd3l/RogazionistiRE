                                                                                                                                      />
                    </Grid>


                    <Border Grid.Row="1"
                            Padding="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="0,0,4,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:ConnectionId='36' Grid.Row="0"                       
                                       Margin="12,12,12,8"
                                       TextWrapping="Wrap"
                                       TextTrimming="WordEllipsis"
                                       FontSize="15"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock x:ConnectionId='37' Grid.Row="1"                                    
                                       Margin="12, 12, 12, 15"
                                       TextWrapping="Wrap"
                                       TextTrimming="WordEllipsis"
                                       FontSize="13"
                                       VerticalAlignment="Bottom"
                                       Foreground="DarkGray"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
