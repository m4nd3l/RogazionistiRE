                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           VerticalAlignment="Center"
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>

                        <TextBlock x:ConnectionId='16' Grid.Column="4"                               
                           Margin="2, 12, 12, 15"
                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           FontSize="15"
                           VerticalAlignment="Bottom"
                           Foreground="DarkGray"
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        
                        <Border Grid.Column="6"  Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="6"
                                Height="30"
                                Padding="12,4">
                            <TextBlock x:ConnectionId='17'                       
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
