<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="RogazionistiRE.Windows.Agenda"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RogazionistiRE.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:RogazionistiRE.JsonBlueprints"
    xmlns:obsData="using:RogazionistiRE.Data"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="CommandBarBackground"             Color="Transparent" />
        <SolidColorBrush x:Key="CommandBarBackgroundOpen"         Color="Transparent" />
        <SolidColorBrush x:Key="CommandBarBorderBrushOpen"        Color="Transparent" />
        <SolidColorBrush x:Key="CommandBarBackgroundPointerOver"  Color="Transparent" />
        <SolidColorBrush x:Key="CommandBarBackgroundPressed"      Color="Transparent" />
        <Thickness       x:Key="CommandBarBorderThicknessOpen">0</Thickness>
        
        <DataTemplate x:Key="LessonItemTemplate"                             >
            <ItemContainer x:ConnectionId='42' CornerRadius="{StaticResource OverlayCornerRadius}">
                
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1" 
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="{StaticResource OverlayCornerRadius}">
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='45' Grid.Column="0"                       
                                   Margin="2, 12, 12, 12"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    
                        <TextBlock x:ConnectionId='46' Grid.Column="2"                               
                                   Margin="2, 12, 12, 15"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   FontSize="15"
                                   VerticalAlignment="Bottom"
                                   Foreground="DarkGray"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    </Grid>

                    
                    <Border Grid.Row="1"
                            Padding="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="0,0,4,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:ConnectionId='43' Grid.Row="0"                        
                                   Margin="12,12,12,8"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   FontSize="15"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock x:ConnectionId='44' Grid.Row="1"                                  
                                   Margin="12, 0, 12, 5"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   FontSize="13"
                                   VerticalAlignment="Bottom"
                                   Foreground="DarkGray"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
        <DataTemplate x:Key="HomeworkItemTemplate"                                        >
            <ItemContainer x:ConnectionId='35' CornerRadius="{StaticResource OverlayCornerRadius}">

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
