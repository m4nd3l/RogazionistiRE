    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar Background="Transparent"
                    DefaultLabelPosition="Collapsed"
                    OverflowButtonVisibility="Collapsed"
                    IsOpen="True"
                    IsSticky="True"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center">

            <CommandBar.Resources>
                <Style TargetType="Button">
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                </Style>
            </CommandBar.Resources>

            <CommandBar.Content>
                <TextBlock x:ConnectionId='53' Name="TitleDate" 
                           Margin="64,0,16,0" 
                           VerticalAlignment="Center" 
                           FontSize="22" 
                           FontWeight="Bold"/>
            </CommandBar.Content> 

            <AppBarElementContainer VerticalAlignment="Center">
                <Button x:ConnectionId='60'                            
                        Content="&#xE72B;" 
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Padding="8"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        Name="Previous"/>
            </AppBarElementContainer>

            <AppBarElementContainer VerticalAlignment="Center">
                <CalendarDatePicker x:ConnectionId='59' x:Name="DateSelector"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                                             />
            </AppBarElementContainer> 

            <AppBarElementContainer VerticalAlignment="Center">
                <Button x:ConnectionId='58'                        
                        Content="&#xE72A;" 
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Padding="8"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        Name="Next"/>
            </AppBarElementContainer>
            
            <AppBarElementContainer VerticalAlignment="Center">
                <Button x:ConnectionId='57'                     
                        Margin="8, 0"
                        Content="&#xE8F5;" 
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Padding="8"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        Name="Today"/>
            </AppBarElementContainer>

            <AppBarSeparator VerticalAlignment="Center"/>

            <AppBarElementContainer VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <CheckBox x:ConnectionId='54' Content="Lessons" Name="LessonsCheckbox" Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="True"/>
                    <CheckBox x:ConnectionId='55' Content="Grades"  Name="GradesCheckbox"  Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="True"/>
                    <CheckBox x:ConnectionId='56' Content="Notes"   Name="NotesCheckbox"   Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="True"/>
                </StackPanel>
            </AppBarElementContainer>
        </CommandBar>
        <ScrollViewer Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ItemsView x:ConnectionId='47' Grid.Row="0"                                          
                           HorizontalAlignment="Center"
                           MaxWidth="800"  Width="800"     Padding="16"
                           ItemTemplate="{StaticResource LessonItemTemplate}"
                           SelectionMode="None"
                           IsItemInvokedEnabled="False">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12"/>
                    </ItemsView.Layout>
                </ItemsView>
                <ItemsView x:ConnectionId='48' Grid.Row="1"                                         
                           HorizontalAlignment="Center"
                           MaxWidth="800"  Width="800" Padding="16"
                           ItemTemplate="{StaticResource GradesItemTemplate}"
                           SelectionMode="None"
                           IsItemInvokedEnabled="False">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12"/>
                    </ItemsView.Layout>
                </ItemsView>
                <ItemsView x:ConnectionId='49' Grid.Row="2"                                        
                           HorizontalAlignment="Center"
                           MaxWidth="800"  Width="800" Padding="16"
                           ItemTemplate="{StaticResource NotesItemTemplate}"
                           SelectionMode="None"
                           IsItemInvokedEnabled="False">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12"/>
                    </ItemsView.Layout>
                </ItemsView>
                <ItemsView x:ConnectionId='50' Grid.Row="3"                                              
                           HorizontalAlignment="Center"
                           MaxWidth="800"  Width="800" Padding="16"
                           ItemTemplate="{StaticResource AnnotationsItemTemplate}"
                           SelectionMode="None"
                           IsItemInvokedEnabled="False">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12"/>
                    </ItemsView.Layout>
                </ItemsView>
                <ItemsView x:ConnectionId='51' Grid.Row="4"                                         
                           HorizontalAlignment="Center"
                           MaxWidth="800"  Width="800" Padding="16"
                           ItemTemplate="{StaticResource AgendaItemTemplate}"
                           SelectionMode="None"
                           IsItemInvokedEnabled="False">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12"/>
                    </ItemsView.Layout>
                </ItemsView>
                <ItemsView x:ConnectionId='52' Grid.Row="5"                                           
                           HorizontalAlignment="Center"
                           MaxWidth="800"  Width="800" Padding="16"
                           ItemTemplate="{StaticResource HomeworkItemTemplate}"
                           SelectionMode="None"
                           IsItemInvokedEnabled="False">
                    <ItemsView.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12"/>
                    </ItemsView.Layout>
                </ItemsView>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

