<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="RogazionistiRE.Windows.Annotations"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RogazionistiRE.Windows"
    xmlns:data="using:RogazionistiRE.JsonBlueprints"
    xmlns:subData="using:RogazionistiRE.JsonBlueprints.SubBlueprints"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="NotesItemTemplate"                            >
            <ItemContainer x:ConnectionId='12' CornerRadius="{StaticResource OverlayCornerRadius}">
                
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1" 
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="{StaticResource OverlayCornerRadius}">
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="100" Height="40">
                            <Ellipse x:ConnectionId='17'                             Height="35" Width="35"/>
                            <TextBlock x:ConnectionId='18'                        
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       Foreground="White"/>
                        </Grid>
                        <TextBlock x:ConnectionId='15' Grid.Column="2"                          
                                   Margin="2, 12, 12, 12"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    
                        <TextBlock x:ConnectionId='16' Grid.Column="4"                               
                                   Margin="2, 12, 12, 15"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   FontSize="15"
                                   VerticalAlignment="Bottom"
                                   Foreground="DarkGray"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    </Grid>

                    
                    <Border Grid.Row="1"
                            Padding="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="0,0,4,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:ConnectionId='13' Grid.Row="0"                       
                                   Margin="12,12,12,8"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   FontSize="15"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock x:ConnectionId='14' Grid.Row="1"                                 
                                   Margin="12, 0, 12, 5"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   FontSize="13"
                                   VerticalAlignment="Bottom"
                                   Foreground="DarkGray"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
        
        
        <DataTemplate x:Key="AnnotationsItemTemplate"                                 >
            <ItemContainer x:ConnectionId='3' CornerRadius="{StaticResource OverlayCornerRadius}">

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderThickness="1" 
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              CornerRadius="{StaticResource OverlayCornerRadius}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="100" Height="40">
                            <Ellipse x:ConnectionId='9'                             Height="35" Width="35"/>
                            <TextBlock x:ConnectionId='10'                        
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               Foreground="White"/>
                        </Grid>
                        <TextBlock x:ConnectionId='6' Grid.Column="2"                          
                           Margin="2, 12, 12, 12"
                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           VerticalAlignment="Center"
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>

                        <TextBlock x:ConnectionId='7' Grid.Column="4"                               
                           Margin="2, 12, 12, 15"
                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           FontSize="15"
                           VerticalAlignment="Bottom"
                           Foreground="DarkGray"
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        
                        <Border Grid.Column="6"  Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="6"
                                Height="30"
                                Padding="12,4">
                            <TextBlock x:ConnectionId='8'                       
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>


                    <Border Grid.Row="1"
                            Padding="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="0,0,4,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:ConnectionId='4' Grid.Row="0"                        
                                                                     
                                       TextWrapping="Wrap"
                                       TextTrimming="WordEllipsis"
                                       FontSize="15"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock x:ConnectionId='5' Grid.Row="1"                                   
                                       Margin="12, 12, 12, 15"
                                       TextWrapping="Wrap"
                                       TextTrimming="WordEllipsis"
                                       FontSize="13"
                                       VerticalAlignment="Bottom"
                                       Foreground="DarkGray"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>
    
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ItemsView x:ConnectionId='19' Grid.Row="0"                                        
                       HorizontalAlignment="Center"
                       MaxWidth="800"  Width="800"     Padding="16"
                       ItemTemplate="{StaticResource NotesItemTemplate}"
                       SelectionMode="None"
                       IsItemInvokedEnabled="False">
                <ItemsView.Layout>
                    <StackLayout Orientation="Vertical" Spacing="12"/>
                </ItemsView.Layout>
            </ItemsView>
            <ItemsView x:ConnectionId='20' Grid.Row="2"                                              
                       HorizontalAlignment="Center"
                       MaxWidth="800"  Width="800" Padding="16"
                       ItemTemplate="{StaticResource AnnotationsItemTemplate}"
                       SelectionMode="None"
                       IsItemInvokedEnabled="False">
                <ItemsView.Layout>
                    <StackLayout Orientation="Vertical" Spacing="12"/>
                </ItemsView.Layout>
            </ItemsView>
        </Grid>
    </ScrollViewer>
</Page>

