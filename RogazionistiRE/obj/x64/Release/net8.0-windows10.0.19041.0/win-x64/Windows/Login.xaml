<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RogazionistiRE.Windows.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RogazionistiRE.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Login">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid x:ConnectionId='2' x:Name="RootContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TitleBar x:ConnectionId='8' x:Name="LoginTitleBar">
                <TitleBar.IconSource>
                    <FontIconSource Glyph="&#xE8F1;"/>
                </TitleBar.IconSource>
            </TitleBar>

            <StackPanel Grid.Row="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center" 
                        Spacing="12"
                        Width="400"
                        Padding="32"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="8">

                <TextBlock x:ConnectionId='9' x:Name="Title" 
                           Text="Welcome"
                           FontSize="32" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,0"/>

                <TextBlock x:ConnectionId='10' x:Name="Signin" 
                           Text="Please sign in to continue" 
                           HorizontalAlignment="Center" 
                           FontSize="14"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           Margin="0,0,0,10"/>

                <TextBox x:ConnectionId='11' x:Name="Username" 
                         PlaceholderText="Username" 
                         FontSize="14"
                         Height="40"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Left"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:ConnectionId='15' x:Name="Password" 
                                 PlaceholderText="Password" 
                                 FontSize="14"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 IsPasswordRevealButtonEnabled="False"/>
                    <Button x:ConnectionId='16' x:Name="ShowPassword" 
                                                       
                            VerticalAlignment="Stretch"
                            Margin="8,0,0,0"
                            Grid.Column="1"
                            Width="40">
                        <FontIcon x:ConnectionId='17' x:Name="ShowPasswordGlyph" Glyph="&#xED1A;" FontSize="14"/>
                    </Button>
                </Grid>

                <CheckBox x:ConnectionId='12' x:Name="RememberMe" 
                          Content="Remember me" 
                          FontSize="14"
                          Margin="0,2,0,0"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:ConnectionId='13' x:Name="LoginButton" 
                            Content="Login" 
                            FontSize="15"
                            FontWeight="SemiBold"
                            Height="44"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                                         />
                    <Button x:ConnectionId='14' x:Name="ChangeLanguage" 
                                                   
                            Margin="8,0,0,0"
                            Width="44"
                            Height="44"
                            Grid.Column="1">
                        <FontIcon Glyph="&#xE774;" FontSize="16"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid x:ConnectionId='3' x:Name="ProgressOverlay" 
              Visibility="Collapsed"
              Opacity="0"
              Canvas.ZIndex="100">
            
            <Grid.Resources>
                <Storyboard x:ConnectionId='4' x:Name="FadeInOverlay">
                    <DoubleAnimation Storyboard.TargetName="ProgressOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.25"/>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ProgressOverlay"
                                                   Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>

                <Storyboard x:ConnectionId='5' x:Name="FadeOutOverlay">
                    <DoubleAnimation Storyboard.TargetName="ProgressOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1.0" To="0.0" Duration="0:0:0.25"/>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ProgressOverlay"
                                                   Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Collapsed"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </Grid.Resources>

            <Rectangle>
                <Rectangle.Fill>
                    <AcrylicBrush AlwaysUseFallback="False" 
                                  TintOpacity="0.6" 
                                  TintColor="{ThemeResource SystemAltHighColor}"/>
                </Rectangle.Fill>
            </Rectangle>
            
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing x:ConnectionId='6' x:Name="ProgressRing" IsActive="True" Width="64" Height="64"/>
                <TextBlock x:ConnectionId='7' x:Name="Auth" 
                           Text="Authenticating..." 
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

